<?xml version="1.0"?>
<robot name="rafiq" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Parameters: change these here, not inside the links -->
  <xacro:property name="base_length" value="0.40"/>
  <xacro:property name="base_width" value="0.28"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="ground_clearance" value="0.02"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="lidar_height" value="0.04"/>

  <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>

  <xacro:macro name="box_inertia" params="m x y z oz:=0">
  <inertial>
    <origin xyz="0 0 ${oz}"/>
    <mass value="${m}"/>
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
  </inertial>
</xacro:macro>

<xacro:macro name="cylinder_inertia" params="m r h">
  <inertial>
    <mass value="${m}"/>
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
  </inertial>
</xacro:macro>

<xacro:macro name="sphere_inertia" params="m r">
  <inertial>
    <mass value="${m}"/>
    <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0" iyy="${2*m*r*r/5}" iyz="0" izz="${2*m*r*r/5}"/>
  </inertial>
</xacro:macro>
  <!-- On the ground, directly below the robot centre -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${ground_clearance + base_height/2 - wheel_radius}"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${ground_clearance + base_height/2 - wheel_radius}"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="5.0" x="${base_length}" y="${base_width}" z="${base_height}" oz="${ground_clearance + base_height/2 - wheel_radius}"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <!-- Wheel macro: called once per side -->
  <xacro:macro name="wheel" params="name y_sign">
    <link name="${name}_wheel_link">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="${wheel_width}"/>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="0 ${y_sign * (base_width/2 + wheel_width/2)} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left" y_sign="1"/>
  <xacro:wheel name="right" y_sign="-1"/>

  <!-- Two passive casters (frictionless spheres in simulation) -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
      <visual><geometry><sphere radius="0.02"/></geometry><material name="grey"/></visual>
      <collision><geometry><sphere radius="0.02"/></geometry></collision>
    xacro:sphere_inertia m="0.05" r="0.02"/>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${x} 0 ${0.02 - wheel_radius}"/>
    </joint>
  </xacro:macro>

  <xacro:caster name="front" x="0.15"/>
  <xacro:caster name="rear" x="-0.15"/>

  <!-- Lidar on top, slightly forward -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="${lidar_height}"/></geometry>
      <material name="black"/>
    </visual>
    <xacro:cylinder_inertia m="0.1" r="0.04" h="${lidar_height}"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.10 0 ${ground_clearance + base_height + lidar_height/2 - wheel_radius}"/>
  </joint>

  <!-- IMU (no shape, just a frame) -->
  <link name="imu_link">
  <xacro:box_inertia m="0.01" x="0.02" y="0.02" z="0.02"/>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.06"/>
  </joint>

<xacro:macro name="slippery" params="name">
  <gazebo reference="${name}_caster_link">
    <mu1>0.0</mu1><mu2>0.0</mu2>
  </gazebo>
</xacro:macro>
<xacro:slippery name="front"/>
<xacro:slippery name="rear"/>
<ros2_control name="GazeboSystem" type="system">
  <hardware>
    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
  </hardware>
  <joint name="left_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="right_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
</ros2_control>

<gazebo>
  <plugin filename="gz_ros2_control-system"
          name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    <parameters>$(find rafiq_description)/config/controllers.yaml</parameters>
  </plugin>
</gazebo>
<gazebo reference="lidar_link">
  <sensor name="lidar" type="gpu_lidar">
    <topic>scan</topic>
    <gz_frame_id>lidar_link</gz_frame_id>
    <update_rate>10</update_rate>
    <always_on>true</always_on>
    <lidar>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range><min>0.12</min><max>10.0</max><resolution>0.01</resolution></range>
      <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
    </lidar>
  </sensor>
</gazebo>

<gazebo reference="imu_link">
  <sensor name="imu" type="imu">
    <topic>imu</topic>
    <gz_frame_id>imu_link</gz_frame_id>
    <update_rate>100</update_rate>
    <always_on>true</always_on>
  </sensor>
</gazebo>
</robot>